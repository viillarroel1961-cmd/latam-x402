# Direccion publica EVM (MetaMask) donde recibes USDC en Base (NUNCA pegues llave privada ni frase semilla)
PAY_TO_ADDRESS=0x000000000000000000000000000000000000dEaD

# Red x402 en formato CAIP-2:
#   eip155:84532 = Base Sepolia (testnet, usar primero para validar)
#   eip155:8453  = Base Mainnet (produccion, USDC real)
X402_NETWORK=eip155:84532

# Facilitador x402 sin Coinbase CDP / sin KYC
X402_FACILITATOR_URL=https://facilitator.payai.network

# Precios por consulta en USD (pagados en USDC)
PRICE_BCV=$0.002
PRICE_BVC=$0.005
PRICE_CRYPTO=$0.002
PRICE_CRYPTO_SIGNALS=$0.005
PRICE_NYSE=$0.003
PRICE_LATAM_FX=$0.005
PRICE_DEFI_YIELDS=$0.005
PRICE_PREDICTIONS=$0.005
PRICE_ECOSYSTEM=$0.01

# Opcional: URL base raw de GitHub para leer snapshots actualizados por GitHub Actions sin redeploy
# Ejemplo: https://raw.githubusercontent.com/viillarroel1961-cmd/latam-x402/main/data
DATA_REMOTE_BASE_URL=

# Puerto local para desarrollo
PORT=3000
